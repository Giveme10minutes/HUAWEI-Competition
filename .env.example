# Future application adapter placeholders. No provider protocol is assumed.
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_DB_PATH=./local_data/app.sqlite3
# Confirm these in the real AgentArts account before application integration.
AGENTARTS_ENDPOINT=
AGENTARTS_APPLICATION_ID=
AGENTARTS_REGION=
# Authentication type and secret variable names must follow the verified API.
# Store real credentials only in an ignored local .env file.

# Managed Agents WebSocket smoke test (verified official guide 2026-11-02).
# API Key here is the agent inbound key, NOT the MaaS model provider key.
AGENTARTS_WS_URL=ws://YOUR_ENDPOINT/runtimes/managed-YOUR_RUNTIME/ws
AGENTARTS_API_KEY=

# Low-code single-agent HTTP/SSE probe and local prototype backend.
# Separate deployment and inbound key; do not reuse Managed Agents or MaaS credentials.
# The backend reads this file from the repository root at startup; never commit a real .env.
AGENTARTS_LOWCODE_URL=
AGENTARTS_LOWCODE_API_KEY=
# Optional read timeout in seconds (default 180, clamped to 10-600).
AGENTARTS_LOWCODE_TIMEOUT=
