{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application Plan Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "period_days",
    "available_minutes",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "status": {
      "const": "draft"
    },
    "period_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "available_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "kind",
          "title",
          "purpose",
          "actions",
          "estimated_minutes",
          "deliverable",
          "acceptance",
          "source_ids",
          "cost_note",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "exploration",
              "learning",
              "practice",
              "reflection"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "deliverable": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cost_note": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "not_started"
          }
        }
      }
    }
  }
}
